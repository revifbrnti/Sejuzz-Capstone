# ==========================================
# KONFIGURASI SERVER
# ==========================================
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ==========================================
# DATABASE (PostgreSQL via Neon.tech)
# ==========================================
# Ganti dengan Connection String database Anda sendiri
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"

# ==========================================
# LAYANAN AI (FastAPI)
# ==========================================
# Ganti dengan URL dan API Key dari tim AI Anda
AI_SERVICE_URL=https://url-api-tim-ai-anda.com/api/v1
AI_API_KEY=masukkan_api_key_rahasia_disini

# ==========================================
# KEAMANAN (JWT)
# ==========================================
# Gunakan string acak yang panjang dan aman
JWT_SECRET=masukkan_secret_key_jwt_disini